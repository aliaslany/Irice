{
  "name": "irice",
  "version": "0.0.0",
  "private": true,
  "description": "Mill-direct Iranian rice storefront (fa-IR, RTL): every bag traceable to its milling lot — origin, Jalali harvest year, lab certificates, price history — with ZarinPal checkout, phone-OTP login, and a loyalty 'Rice Passport'.",
  "keywords": [
    "ecommerce",
    "nextjs",
    "iran",
    "persian",
    "farsi",
    "rtl",
    "rice",
    "traceability",
    "jalali",
    "zarinpal",
    "drizzle-orm",
    "postgresql",
    "typescript",
    "structured-data",
    "seo"
  ],
  "homepage": "https://github.com/aliaslany/Irice#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliaslany/Irice.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "node scripts/e2e-checkout.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "jalaali-js": "^1.2.8",
    "next": "^16.3.5",
    "postgres": "^3.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
