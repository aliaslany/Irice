# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/irice

# Required, no default in any environment. Gates the whole admin surface
# (approving returns, uploading lab certificates) — see globals/config.ts
# and modules/admin/auth.ts. Generate one real value, don't leave this blank.
ADMIN_TOKEN=

# Payments — ZarinPal (36-char merchant id). Sandbox until go-live.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# SMS / OTP
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=irice-otp

# Free shipping threshold, in RIAL (not Toman). 0 disables it.
FREE_SHIPPING_THRESHOLD_RIAL=0

# 32+ chars
SESSION_SECRET=

# Base URL used to build payment-gateway callback/redirect links.
SITE_URL=http://localhost:3000

# NEVER set this to true on anything a real customer can reach: it exposes
# GET /api/dev/last-otp, which lets whoever can read the response log in as
# any phone number. Exists only so CI/staging/local dev can complete an OTP
# login without a real SMS provider. See globals/config.ts.
ALLOW_DEV_OTP_PEEK=false

# eNamad ("نماد اعتماد الکترونیکی") — Iran's government e-commerce trust
# seal. Both blank until the business has actually registered at enamad.ir
# and been issued a real id/code pair from its dashboard; the footer shows
# no badge at all until then. Never fill these with placeholder values —
# see globals/config.ts and components/EnamadBadge.tsx.
ENAMAD_ID=
ENAMAD_CODE=
